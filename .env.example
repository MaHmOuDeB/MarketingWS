# Copy to .env and fill in. Without OPENAI_API_KEY the app runs in demo mode (placeholder copy, no cost).
OPENAI_API_KEY=
# Any current OpenAI model id; gpt-3.5-turbo (thesis version) shuts down on 2026-10-23.
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=            # optional: any OpenAI-compatible endpoint
# OPENAI_TEMPERATURE=0.7      # ignored for reasoning models (o-series, gpt-5.x)

# Protection for a public deployment
# APP_API_KEY: if set, clients must send the X-API-Key header (the Streamlit UI sends it server-side)
APP_API_KEY=
RATE_LIMIT_PER_MIN=20
# CORS_ORIGINS: comma-separated browser origins, only if a web frontend calls the API directly
CORS_ORIGINS=
# DEMO_MODE=true              # force demo mode even with a key
