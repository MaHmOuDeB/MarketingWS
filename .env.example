# Copy to .env and fill in. Without a model API key the app runs in demo mode (placeholder copy, no cost).
# Set ONE of the two keys (or both, and choose with LLM_PROVIDER).
# LLM_PROVIDER=anthropic      # openai | anthropic | demo — default: whichever key is set (OpenAI first)

# OpenAI
OPENAI_API_KEY=
# Any current OpenAI model id; gpt-3.5-turbo (thesis version) shuts down on 2026-10-23.
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=            # optional: any OpenAI-compatible endpoint, e.g. free Google Gemini:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  OPENAI_MODEL=gemini-2.5-flash
# OPENAI_TEMPERATURE=0.7      # ignored for reasoning models (o-series, gpt-5.x)

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# claude-haiku-4-5 is fast and inexpensive; claude-sonnet-5 writes better copy at a higher price
ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_TEMPERATURE=0.7

# Protection for a public deployment
# APP_API_KEY: if set, clients must send the X-API-Key header (the Streamlit UI sends it server-side)
APP_API_KEY=
RATE_LIMIT_PER_MIN=20
# CORS_ORIGINS: comma-separated browser origins, only if a web frontend calls the API directly
CORS_ORIGINS=
# DEMO_MODE=true              # force demo mode even with a key
